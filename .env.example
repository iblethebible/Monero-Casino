# Reference only: export these variables into each process; .env is not auto-loaded.
# Generate FLASK_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
FLASK_SESSION_COOKIE_SECURE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=casino_admin
DB_PASSWORD=
DB_NAME=monero_casino
MONERO_DAEMON_RPC_URL=http://127.0.0.1:18089/json_rpc
MONERO_DAEMON_RPC_USER=
MONERO_DAEMON_RPC_PASSWORD=
MONERO_DAEMON_RPC_TIMEOUT=10
MONERO_DAEMON_MAX_TIP_AGE_SECONDS=1200
MONERO_BET_MIN_CONFIRMATIONS=10
MONERO_DEPOSIT_MIN_CONFIRMATIONS=10
MONERO_BET_CUTOFF_BLOCKS=2
MONERO_WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
